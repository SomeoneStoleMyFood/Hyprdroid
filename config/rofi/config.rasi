configuration {
    modes:                  "drun";
    show-icons:             true;
    icon-theme:             "Papirus";
    display-drun:           "Apps";
    display-run:            "Run";
    display-window:         "Windows";
    drun-display-format:    "{name}";
    hover-select:           true;
    me-select-entry:        "";
    me-accept-entry:        "MousePrimary";
}

@theme "material"
