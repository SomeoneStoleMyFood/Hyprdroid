{
  "bar": {
    "heightPercent": 2.4,
    "minHeight": 22,
    "maxHeight": 56,
    "iconScale": 0.55,
    "use24h": true,
    "font": "Google Sans Flex",
    "scrim": true,
    "scrimOpacity": 0.45,
    "hideOnFullscreen": true,
    "hoverStrip": 3,
    "maxNotifIcons": 5,
    "monoNotifIcons": false,
    "clockFont": "Google Sans Flex",
    "clockBold": true
  },
  "colors": {
    "fg": "#FFFFFF",
    "fgDim": "#B3FFFFFF",
    "track": "#59FFFFFF",
    "warn": "#F2B8B5",
    "saver": "#F9D66F",
    "privacyGreen": "#6DD58C",
    "privacyInk": "#00391A",
    "surface": "#1D1F24",
    "container": "#2A2D34",
    "containerHigh": "#3B3F48",
    "onSurface": "#FFFFFF",
    "onSurfaceVar": "#FFFFFF",
    "primary": "#8AB4FF",
    "onPrimary": "#062E6F",
    "primaryContainer": "#2E4A73",
    "onPrimaryContainer": "#FFFFFF",
    "tileActive": "#2F6FE4",
    "onTileActive": "#FFFFFF",
    "text": "#FFFFFF"
  },
  "icons": {
    "showWifiOff": true,
    "showWifiDisconnected": true,
    "showBluetoothOff": true,
    "airplaneWhenAllOff": true
  },
  "network": {
    "pollSeconds": 6
  },
  "shade": {
    "enabled": true,
    "screen": "focused",
    "swipeThresholdPx": 16,
    "openFraction": 0.3,
    "swipeDistanceFraction": 0.45,
    "animationMs": 450,
    "radius": 36,
    "tiles": [
      "wifi",
      "bluetooth",
      "dnd",
      "saver",
      "airplane",
      "mute",
      "mic"
    ],
    "customTiles": [
      {
        "label": "Screenshot",
        "icon": "camera",
        "command": [
          "sh",
          "-c",
          "grim -g \"$(slurp)\" - | wl-copy"
        ]
      }
    ],
    "closeAnimationMs": 280,
    "backgroundOpacity": 1.0,
    "maxWidth": 0,
    "showVolume": true,
    "sideMargin": 56,
    "dimOtherScreens": 0.75,
    "powerMenu": [
      {
        "label": "Lock",
        "icon": "lock",
        "command": [
          "qs",
          "ipc",
          "call",
          "lock",
          "lock"
        ]
      },
      {
        "label": "Sleep",
        "icon": "sleep",
        "command": [
          "systemctl",
          "suspend"
        ]
      },
      {
        "label": "Restart",
        "icon": "restart",
        "command": [
          "systemctl",
          "reboot"
        ]
      },
      {
        "label": "Power off",
        "icon": "power",
        "command": [
          "systemctl",
          "poweroff"
        ],
        "danger": true
      },
      {
        "label": "Log out",
        "icon": "logout",
        "command": [
          "hyprctl",
          "dispatch",
          "exit"
        ]
      }
    ],
    "widgets": [
      "alarm",
      "timer",
      "weather",
      "system"
    ]
  },
  "toasts": {
    "enabled": true,
    "screen": "main",
    "timeoutMs": 6000,
    "width": 400,
    "maxVisible": 3,
    "radius": 26,
    "topMarginPx": 8,
    "showInDnd": false,
    "criticalIgnoresDnd": true
  },
  "startup": {
    "video": "start.mp4",
    "volume": 1.0,
    "mainMonitor": "",
    "playOnLaunch": false
  },
  "weather": {
    "city": "",
    "units": "m"
  },
  "lock": {
    "avatar": "",
    "name": "",
    "allowIpcUnlock": false
  }
}